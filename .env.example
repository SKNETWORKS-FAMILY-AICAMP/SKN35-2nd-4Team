# 로컬 개발용. 실제 값이 든 .env 는 커밋하지 않는다(.gitignore 에 포함).
# Streamlit Cloud 에는 .env 가 없다 — 거기서는 .streamlit/secrets.toml 을 쓴다
# (secrets.toml.example 참고). supabase_client.py 가 둘 다 읽는다.

# Supabase > Project Settings > Database > Connection string (URI)
# 예: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase REST API 를 쓸 경우에만 필요 (지금 코드는 psycopg2 직결이라 선택)
SUPABASE_URL=
SUPABASE_KEY=
