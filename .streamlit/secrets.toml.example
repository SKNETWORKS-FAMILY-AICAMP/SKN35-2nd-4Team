# Streamlit Cloud 배포용 시크릿 템플릿.
#
# 이 파일(.example)만 커밋하고, 실제 값이 든 .streamlit/secrets.toml 은
# 절대 커밋하지 않는다(.gitignore 에 포함되어 있음).
#
# Streamlit Cloud 에서는 파일을 올리는 게 아니라
#   앱 대시보드 > Settings > Secrets
# 에 아래 내용을 그대로 붙여넣는다.

# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL = "postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# REST API 를 쓸 경우에만 (현재 코드는 psycopg2 직결이라 선택 사항)
SUPABASE_URL = ""
SUPABASE_KEY = ""
